NODE_ENV=production
PORT=5000
CLIENT_URL=https://your-frontend-domain.com

MONGO_URI=
# Use a long random secret (32+ characters).
JWT_SECRET=
MONGO_MAX_POOL_SIZE=20

# Email (optional but required for production email notifications)
EMAIL_USER=
EMAIL_APP_PASSWORD=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Waventra Vetric
ORDER_NOTIFICATION_EMAIL=

# Cloudinary (required for product image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI provider (server-side only)
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=

# AI automation
AI_AUTOMATION_ENABLED=true
AI_AUTOMATION_INTERVAL_MINUTES=60
AI_LOW_STOCK_THRESHOLD=3

# Web Push
VAPID_SUBJECT=mailto:admin@your-domain.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
